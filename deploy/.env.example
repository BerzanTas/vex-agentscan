SITE_ADDRESS=agentscan.example.com
IMAGE_TAG=latest
NODE_ENV=production
POSTGRES_USER=agentscan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentscan
DATABASE_URL=postgres://agentscan:change-me@postgres:5432/agentscan?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000
PORT=3000
INGEST_RATE_LIMIT_PER_TOKEN=60
INGEST_RATE_WINDOW_SEC=60
REGISTER_RATE_LIMIT_PER_IP=10
REGISTER_RATE_WINDOW_SEC=3600
MAX_BATCH_EVENTS=500
MAX_BODY_BYTES=1048576
QUARANTINE_STRIKES=3
VERIFY_TIME_TOLERANCE_MIN=10
VERIFY_AMOUNT_TOLERANCE_PCT=0.5
VERIFY_BACKOFF_SCHEDULE=1m,5m,30m,2h,12h
VERIFY_MAX_AGE_DAYS=7
VERIFY_FAKE_MODE=off
UNKNOWN_CHAIN_BACKOFF_MIN=360
WORKER_POLL_INTERVAL_SEC=15
WORKER_BATCH=20
# must exceed the worst-case time to resolve one claimed batch: roughly
# ceil(WORKER_BATCH / WORKER_RPC_CONCURRENCY) waves times the worst-case RPC round trip
WORKER_LEASE_SEC=120
WORKER_RPC_CONCURRENCY=10
WORKER_HEARTBEAT_MAX_AGE_SEC=120
PURGE_DELAY_H=24
PURGE_INTERVAL_MIN=60
# whether the worker runs the purge sweep on an interval itself;
# false where a scheduled job owns the sweep instead
PURGE_IN_WORKER=true
PUBLIC_FEED_PAGE_SIZE=25
PUBLIC_AGENT_PAGE_SIZE=25
PUBLIC_TOKEN_PAGE_SIZE=25
# time to live of the response cache on the expensive public read endpoints; 0 disables it
READ_CACHE_TTL_SEC=5
# how long a client should wait after a 503 caused by an exhausted connection pool
POOL_TIMEOUT_RETRY_AFTER_SEC=5
# trusted proxy hop for reading the client address from X-Forwarded-For;
# empty means no trust and request.ip stays the direct peer address
TRUST_PROXY=
# set your own random salt in production; the default is rejected when NODE_ENV=production
AGENT_ALIAS_SALT=agentscan-dev-salt
# set your own random salt in production; the default is rejected when NODE_ENV=production
RATE_LIMIT_KEY_SALT=agentscan-dev-rate-salt
ATTEST_RATE_LIMIT_PER_IP=20
ATTEST_RATE_WINDOW_SEC=3600
ATTEST_MAX_PENDING_PER_IP=100
ATTEST_MAX_PENDING_GLOBAL=10000
# max historical attestation candidate rows scanned per public token lookup
ATTEST_CANDIDATES_MAX=50
# allowlist of the contracts that may prove a token creation, for the attestation worker (not
# ingest). Comma-separated, keyed by CHAIN AND LAUNCHPAD, because chain 4663 hosts three of them
# and widening one must not widen the others:
#   ATTEST_FACTORY_ADDRESSES_<chainId>_<TRENCH|POOLS_FUN|VIRTUALS>
# An entry REPLACES the built-in list for that pair, so it can narrow as well as widen. Leave every
# key unset to use the measured defaults (Trench factory and the three pools.fun gateways on 4663,
# the Virtuals BondingV5 proxies on 4663 and 8453). A key naming an unknown launchpad is ignored.
# ATTEST_FACTORY_ADDRESSES_4663_TRENCH=
# ATTEST_FACTORY_ADDRESSES_4663_POOLS_FUN=
# ATTEST_FACTORY_ADDRESSES_4663_VIRTUALS=
# ATTEST_FACTORY_ADDRESSES_8453_VIRTUALS=
# reorg-safety depth an attestation's tx must reach before a terminal verdict is issued
ATTEST_MIN_CONFIRMATIONS=5
# a never-verified attestation older than this terminalizes as unverifiable rather than retrying forever
ATTEST_MAX_AGE_DAYS=14
ATTEST_WORKER_BATCH=20
ATTEST_WORKER_LEASE_SEC=120
ATTEST_BACKOFF_SCHEDULE=1m,5m,30m,2h,12h
HANDSHAKE_RATE_LIMIT_PER_IP=10
HANDSHAKE_RATE_WINDOW_SEC=3600
# the domain bound into the handshake signature template; must be set to the real
# public domain in production, the default ("localhost") is rejected when
# NODE_ENV=production. MUST equal the hostname of the URL Vex installs dial
# (SITE_ADDRESS, above) -- no scheme, no port, no path: Vex clients compare the
# server's returned `domain` against that dialed URL's `URL#hostname` and refuse
# to sign the handshake template on any mismatch.
HANDSHAKE_DOMAIN=agentscan.example.com
HANDSHAKE_CHALLENGE_TTL_MIN=5
# secret used to HMAC wallet addresses before they are stored; never logged, never
# in the DB; set your own random 32+ character value in production, the default is
# rejected when NODE_ENV=production
WALLET_HMAC_PEPPER=agentscan-dev-wallet-hmac-pepper
# historical price source for the pricing lane; every published USD aggregate is computed from it,
# client-supplied usd estimates are never summed into a public figure
PRICE_FEED_BASE_URL=https://coins.llama.fi
# a feed answer below this confidence, or further than PRICE_MAX_DRIFT_SEC from the activity's own
# timestamp, is treated as a miss: the feed returns its nearest point, which for an illiquid token
# can be days away, and that is a wrong number rather than a stale one
PRICE_MIN_CONFIDENCE=0.9
PRICE_MAX_DRIFT_SEC=3600
# a cached feed miss is refetchable after this many hours; a cached hit is permanent
PRICE_MISS_RETRY_HOURS=24
PRICE_FEED_COINS_PER_REQUEST=50
# a feed request that outlives this is abandoned and retried by the backoff, never left to hang the
# single-flight pricing poll
PRICE_FEED_TIMEOUT_MS=10000
# server price vs client estimate beyond this ratio logs a divergence warning; it never suppresses
# the price, because a false positive would blank a legitimate number
PRICE_DIVERGENCE_WARN_RATIO=5
PRICING_BATCH_MAX=50
# attempts before an activity that cannot be priced becomes terminally unpriced and is disclosed.
# Keep it one greater than the number of PRICING_BACKOFF_SCHEDULE entries: the last attempt is the
# one that terminalises, so a lower value leaves the tail of the schedule unreachable.
PRICING_MAX_ATTEMPTS=6
PRICING_POLL_INTERVAL_SEC=30
# how long a claimed batch stays invisible to other worker replicas before it becomes due again.
# Must exceed the worst-case pass, PRICING_BATCH_MAX x PRICE_FEED_TIMEOUT_MS (500s at the defaults
# above) — there is no lease renewal inside a pass, and a lease that expires mid-pass burns attempts
# at double rate exactly when the feed is already slow.
PRICING_LEASE_SEC=600
# an activity blocked on a cached feed miss is not retried on this ladder; it sleeps until the miss
# is refetchable (PRICE_MISS_RETRY_HOURS), so every attempt it spends carries new information
PRICING_BACKOFF_SCHEDULE=1m,5m,30m,2h,12h
# max verified activities read when building one agent page; reaching it flags the page truncated
PUBLIC_AGENT_ROWS_MAX=5000
# closed round trips an agent needs before a win rate is published at all (below it the page says
# so rather than showing 0%)
WIN_RATE_MIN_ROUND_TRIPS=5
AGE_RECIPIENT=age1exampleexampleexampleexampleexampleexampleexampleexamplex
AGE_IDENTITY_FILE=/etc/agentscan/backup-identity.key
RCLONE_REMOTE=backups:agentscan
BACKUP_RETENTION_DAYS=30
