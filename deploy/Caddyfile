{$SITE_ADDRESS::80} {
	# ORDER MATTERS. Caddy takes the first matching `handle`, so the two asset
	# routes must precede the generic /v1/* handler or every upload and delete
	# would reach the reporting API instead of the asset host.
	handle /a/* {
		reverse_proxy assets:3000
	}
	handle /v1/assets* {
		reverse_proxy assets:3000
	}
	handle /v1/* {
		reverse_proxy api:3000
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>headers>Authorization delete
		}
	}
}
