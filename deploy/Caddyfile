{$SITE_ADDRESS::80} {
	handle /v1/* {
		reverse_proxy api:3000
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 720h
		}
		format filter {
			wrap json
			request>headers>Authorization delete
		}
	}
}
