{
  "name": "vex-agentscan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose -f deploy/compose.yml --env-file deploy/.env.smoke up -d && pnpm --filter @agentscan/web dev",
    "lint": "pnpm -r exec tsc --noEmit && eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "sim": "pnpm --filter @agentscan/server build && node apps/server/dist/entry-sim.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
