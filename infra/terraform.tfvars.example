subscription_id         = "00000000-0000-0000-0000-000000000000"
public_hostname         = "agentscan.example.com"
image_tag               = "put-the-commit-sha-from-ghcr-here"
postgres_admin_password = "generate-randomly"
agent_alias_salt        = "generate-randomly"
rate_limit_key_salt     = "generate-randomly"
# Must be the host Vex installs actually dial: the client compares it against
# the address it chose and refuses to sign the handshake on any mismatch.
handshake_domain        = "agentscan.example.com"
# At least 32 characters. Changing this invalidates every wallet binding
# already stored -- addresses are kept only as HMACs under it and cannot be
# recovered from the database.
wallet_hmac_pepper      = "generate-randomly-min-32-characters"
budget_alert_emails     = ["you@example.com"]
budget_start_date       = "2026-08-01T00:00:00Z"

# Keys: ethereum, base, arbitrum, optimism, polygon, robinhood, unichain, monad,
# hyperevm, bsc, avalanche, linea, mantle, berachain, sonic, plasma, ronin,
# megaeth, solana.
# rpc_url_overrides = {
#   base = "https://base-mainnet.example.com/v2/KEY,https://mainnet.base.org"
# }
rpc_url_overrides = {}
